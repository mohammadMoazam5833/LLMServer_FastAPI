# Copy to 31-gateway-secret.yaml and fill real values.
# DATABASE_URL host must stay "postgres". Password must match postgres secret.
apiVersion: v1
kind: Secret
metadata:
  name: llm-gateway
  namespace: team-b
  labels:
    app.kubernetes.io/name: llm-gateway
    app.kubernetes.io/part-of: llm-fastapi
type: Opaque
stringData:
  SECRET_KEY: "CHANGE_ME_USE_openssl_rand_hex_32"
  DATABASE_URL: "postgresql+asyncpg://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/llm_server"
