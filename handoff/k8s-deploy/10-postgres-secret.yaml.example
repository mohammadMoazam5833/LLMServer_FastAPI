# Copy to 10-postgres-secret.yaml and set a strong password.
apiVersion: v1
kind: Secret
metadata:
  name: llm-postgres
  namespace: team-b
  labels:
    app.kubernetes.io/name: llm-postgres
    app.kubernetes.io/part-of: llm-fastapi
type: Opaque
stringData:
  POSTGRES_USER: postgres
  POSTGRES_PASSWORD: "CHANGE_ME_STRONG_PASSWORD"
  POSTGRES_DB: llm_server
