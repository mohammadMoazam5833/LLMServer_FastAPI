# Copy to 31-gateway-secret.yaml (do NOT commit real values).
#   cp k8s/team-b/31-gateway-secret.yaml.example k8s/team-b/31-gateway-secret.yaml
#
# DATABASE_URL must use the in-cluster Service name `postgres`.
apiVersion: v1
kind: Secret
metadata:
  name: llm-gateway
  namespace: team-b
  labels:
    app.kubernetes.io/name: llm-gateway
    app.kubernetes.io/part-of: llm-fastapi
type: Opaque
stringData:
  SECRET_KEY: "CHANGE_ME_USE_openssl_rand_hex_32"
  # Match user/password/db with llm-postgres secret
  DATABASE_URL: "postgresql+asyncpg://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/llm_server"
