# Copy to 10-postgres-secret.yaml (do NOT commit real passwords).
#   cp k8s/team-b/10-postgres-secret.yaml.example k8s/team-b/10-postgres-secret.yaml
#
# Then either:
#   kubectl apply -f k8s/team-b/10-postgres-secret.yaml
# or add it to kustomization resources after filling values.
apiVersion: v1
kind: Secret
metadata:
  name: llm-postgres
  namespace: team-b
  labels:
    app.kubernetes.io/name: llm-postgres
    app.kubernetes.io/part-of: llm-fastapi
type: Opaque
stringData:
  POSTGRES_USER: postgres
  POSTGRES_PASSWORD: "CHANGE_ME_STRONG_PASSWORD"
  POSTGRES_DB: llm_server
