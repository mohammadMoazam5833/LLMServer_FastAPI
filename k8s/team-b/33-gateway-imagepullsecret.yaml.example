# Optional: for private registries. Copy to 33-gateway-imagepullsecret.yaml
# after admin creates the docker-registry secret, OR create via:
#   kubectl -n team-b create secret docker-registry llm-registry \
#     --docker-server=REGISTRY --docker-username=USER --docker-password=PASS
#
# Then uncomment imagePullSecrets in 32-gateway-deployment.yaml
apiVersion: v1
kind: Secret
metadata:
  name: llm-registry
  namespace: team-b
  labels:
    app.kubernetes.io/name: llm-gateway
    app.kubernetes.io/part-of: llm-fastapi
type: kubernetes.dockerconfigjson
stringData:
  .dockerconfigjson: |
    {
      "auths": {
        "REGISTRY.example.com": {
          "username": "CHANGE_ME",
          "password": "CHANGE_ME",
          "auth": "base64(user:pass)_optional"
        }
      }
    }
